<?xml version="1.0" encoding="utf-8"?>
<!--
The screen does not fit on a phone, so the content scrolls. Without this the
last entries are simply unreachable - including by TalkBack, which cannot
scroll a LinearLayout that does not know it is too tall.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.settingsactivity.SettingsActivity">
<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Switch
        android:id="@+id/flashlightSwitch"
        android:text="Use flashlight by default"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
    <Switch
        android:id="@+id/soundsSwitch"
        android:text="Use sounds"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
    <Switch
        android:id="@+id/describeSavedImagesSwitch"
        android:text="Automatically describe saved images using the file description config"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        >
        <TextView
            android:id="@+id/defaultConfigLabel"
            android:text="Default config:"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            />
        <TextView
            android:id="@+id/defaultConfigSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onDefaultConfigSelectorClick"
            />
        </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        >
        <TextView
            android:id="@+id/shareConfigLabel"
            android:text="Share config:"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            />
        <TextView
            android:id="@+id/shareConfigSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onShareConfigSelectorClick"
            />
        </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        >
        <TextView
            android:id="@+id/fileDescriptionConfigLabel"
            android:text="File description config:"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            />
        <TextView
            android:id="@+id/fileDescriptionConfigSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onFileDescriptionConfigSelectorClick"
            />
        </LinearLayout>

    <TextView
        android:text="Event actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        >
        <TextView
            android:id="@+id/shakeActionLabel"
            android:text="Shake:"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            />
        <TextView
            android:id="@+id/shakeActionSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onShakeActionSelectorClick"
            />
        </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        >
        <TextView
            android:id="@+id/volumeUpPressActionLabel"
            android:text="Volume up press:"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            />
        <TextView
            android:id="@+id/volumeUpPressActionSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onVolumeUpPressActionSelectorClick"
            />
        </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        >
        <TextView
            android:id="@+id/volumeDownPressActionLabel"
            android:text="Volume down press:"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            />
        <TextView
            android:id="@+id/volumeDownPressActionSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onVolumeDownPressActionSelectorClick"
            />
        </LinearLayout>

    <TextView
        android:id="@+id/apiProvidersLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="API providers"
        android:onClick="onApiProvidersLabelClick"
        />
    <TextView
        android:id="@+id/modelProviderMappingsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Providers for models"
        android:onClick="onModelProviderMappingsLabelClick"
        />

    <TextView
        android:text="Expiry inspection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />

    <Switch
        android:id="@+id/speakGuidanceSwitch"
        android:text="Speak inspection instructions aloud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
    <Switch
        android:id="@+id/storeInspectionImagesSwitch"
        android:text="Keep inspection photographs in the research log"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
    <Switch
        android:id="@+id/retrievalMemorySwitch"
        android:text="Plan the search using where similar packages print their dates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
    <Switch
        android:id="@+id/retrievalNameMatchingSwitch"
        android:text="Also match brand names printed on the package"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
    <Switch
        android:id="@+id/ablationArmsSwitch"
        android:text="Record what other capture policies would have done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />

    <Switch
        android:id="@+id/instructionGroundingSwitch"
        android:text="Name the face in movement instructions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />

    <TextView
        android:labelFor="@+id/productLabelSelector"
        android:text="Study package in hand:"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
    <Spinner
        android:id="@+id/productLabelSelector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />

    <TextView
        android:text="Capture ablation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />

    <Switch
        android:id="@+id/autoCaptureSwitch"
        android:text="Take photographs automatically when the view settles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />

    <TextView
        android:labelFor="@+id/gateConditionSelector"
        android:text="Capture controller:"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
    <Spinner
        android:id="@+id/gateConditionSelector"
        android:contentDescription="Capture controller driving the camera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />

    <TextView
        android:labelFor="@+id/blockLabelSelector"
        android:text="Scripted behaviour for this session:"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
    <Spinner
        android:id="@+id/blockLabelSelector"
        android:contentDescription="Scripted behaviour recorded with the session"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />

    </LinearLayout>
    </ScrollView>
