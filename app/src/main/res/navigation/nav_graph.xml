<?xml version="1.0" encoding="utf-8"?>
<!--
One destination. The scan, config-list, options and conversation fragments still
exist in the source and still compile; they are simply not reachable, which is
what makes going back to the full app a matter of restoring this file and the
bottom navigation bar rather than rewriting anything.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/expiryFragment">

    <fragment
        android:id="@+id/expiryFragment"
        android:name="com.rastislavkish.vscan.ui.mainactivity.ExpiryFragment"
        android:label="Expiry date"
        tools:layout="@layout/fragment_expiry" />
    </navigation>
